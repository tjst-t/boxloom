{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boxloom.invalid/schema/ir/0.1/types/pairs.schema.json",
  "title": "Boxloom IR: pairs block (0.1)",
  "description": "対の並び(標準でない型。docs/layers.md の8.1)。「分かったこと ↔ 打ち手」のように、2つの側の見出しを1回だけ書き、その下に対を並べる。対の2つの側は行がそろう。側の名前は意味で、subject はその対が何についてか(分かったこと・課題・問い)、response はそれに応えるもの(打ち手・対策・答え)。どちらの側に置くか・幅・色は書けない。組み方を持たないテンプレートは columns で組む(component-fallback)。",
  "type": "object",
  "properties": {
    "type": {
      "const": "pairs"
    },
    "variant": {
      "$ref": "../core.schema.json#/$defs/variant"
    },
    "headings": {
      "description": "2つの側の見出し(列の題)。1回だけ書く。",
      "type": "object",
      "properties": {
        "subject": {
          "description": "対の何についての側の見出し(例: 分かったこと)。",
          "$ref": "../core.schema.json#/$defs/inline"
        },
        "response": {
          "description": "それに応える側の見出し(例: 打ち手)。",
          "$ref": "../core.schema.json#/$defs/inline"
        }
      },
      "required": [
        "subject",
        "response"
      ],
      "additionalProperties": false
    },
    "pairs": {
      "description": "対の並び(2つ以上)。上から順に読む。",
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/pair"
      }
    }
  },
  "required": [
    "type",
    "headings",
    "pairs"
  ],
  "additionalProperties": false,
  "$defs": {
    "pair": {
      "description": "1つの対。2つの側はそれぞれ、段落・箇条・引用のどれか1つか、見出しと複数のブロックのまとまり(sideGroup)。",
      "type": "object",
      "properties": {
        "subject": {
          "$ref": "#/$defs/side"
        },
        "response": {
          "$ref": "#/$defs/side"
        }
      },
      "required": [
        "subject",
        "response"
      ],
      "additionalProperties": false
    },
    "side": {
      "description": "対の1つの側。段落・箇条・引用のどれか1つのブロックか、見出しと複数のブロックのまとまり。",
      "oneOf": [
        {
          "$ref": "../core.schema.json#/$defs/paragraph"
        },
        {
          "$ref": "../core.schema.json#/$defs/points"
        },
        {
          "$ref": "../core.schema.json#/$defs/quote"
        },
        {
          "$ref": "#/$defs/sideGroup"
        }
      ]
    },
    "sideGroup": {
      "description": "見出しと複数のブロックの側(例: 要因の名前+箇条、箇条+引用)。見出しはその側の短い文。",
      "type": "object",
      "properties": {
        "title": {
          "description": "その側の見出し(短い文。文中の記法を読む)。",
          "$ref": "../core.schema.json#/$defs/inline"
        },
        "body": {
          "description": "側の中のブロック(1〜4個。上から順に積む)。",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/sideBlock"
          }
        }
      },
      "required": [
        "body"
      ],
      "additionalProperties": false
    },
    "sideBlock": {
      "description": "側の中に置けるブロック:段落・箇条・引用・画像・表(続きの表は置けない)。",
      "oneOf": [
        {
          "$ref": "../core.schema.json#/$defs/paragraph"
        },
        {
          "$ref": "../core.schema.json#/$defs/points"
        },
        {
          "$ref": "../core.schema.json#/$defs/quote"
        },
        {
          "$ref": "../core.schema.json#/$defs/image"
        },
        {
          "allOf": [
            {
              "$ref": "../core.schema.json#/$defs/table"
            },
            {
              "not": {
                "required": [
                  "continues"
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
