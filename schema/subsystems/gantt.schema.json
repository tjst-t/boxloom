{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boxloom.invalid/schema/ir/0.1/subsystems/gantt.schema.json",
  "title": "Boxloom IR: gantt subsystem (0.1)",
  "description": "Gantt サブシステムのブロック。期間・状態・注釈という意味だけを持つ。軸の圧縮の具合・吹き出しの位置・色は、サブシステムとテンプレートが決める。",
  "type": "object",
  "properties": {
    "type": { "const": "subsystem" },
    "subsystem": { "const": "gantt" },
    "variant": { "$ref": "../core.schema.json#/$defs/variant" },
    "data": { "$ref": "#/$defs/chart" }
  },
  "required": ["type", "subsystem", "data"],
  "additionalProperties": false,

  "$defs": {
    "date": { "$ref": "../core.schema.json#/$defs/date" },
    "range": { "$ref": "../core.schema.json#/$defs/dateRange" },
    "inline": { "$ref": "../core.schema.json#/$defs/inline" },
    "lines": { "$ref": "../core.schema.json#/$defs/lines" },
    "id": { "$ref": "../core.schema.json#/$defs/id" },

    "status": {
      "description": "区間・目盛り・注釈の状態。Gantt サブシステムが名乗る意味役割名で、色はテンプレートがこの名前に当てる。",
      "enum": ["support", "conditional", "none", "danger"]
    },
    "legendKey": {
      "description": "凡例に出せるもの。状態の名前と、リスク帯(risk)。",
      "enum": ["support", "conditional", "none", "danger", "risk"]
    },

    "chart": {
      "type": "object",
      "properties": {
        "span": {
          "description": "時間軸の範囲。",
          "$ref": "#/$defs/range"
        },
        "axisBreakBefore": {
          "description": "この日付の手前で軸を切る(間が重要でないことを示す、// の印)。",
          "$ref": "#/$defs/date"
        },
        "ticks": {
          "description": "軸の目盛り。日付の表記(例 29/12)はテンプレートが作り、label はその下に添える説明。",
          "type": "array",
          "items": { "$ref": "#/$defs/tick" }
        },
        "milestones": {
          "type": "array",
          "items": { "$ref": "#/$defs/milestone" }
        },
        "legend": {
          "description": "凡例。キーは状態の名前か risk、値は説明。書いた順に並べる。",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/legendKey" },
          "additionalProperties": { "$ref": "#/$defs/inline" }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/group" }
        },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/annotation" }
        }
      },
      "required": ["span", "groups"],
      "additionalProperties": false
    },

    "tick": {
      "type": "object",
      "properties": {
        "at": { "$ref": "#/$defs/date" },
        "label": { "$ref": "#/$defs/inline" },
        "status": { "$ref": "#/$defs/status" }
      },
      "required": ["at"],
      "additionalProperties": false
    },
    "milestone": {
      "type": "object",
      "properties": {
        "at": { "$ref": "#/$defs/date" },
        "label": { "$ref": "#/$defs/inline" }
      },
      "required": ["at", "label"],
      "additionalProperties": false
    },

    "group": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/lines" },
        "risk": {
          "description": "このグループにかかるリスクの期間(例 ハードウェアの保守切れ)。",
          "$ref": "#/$defs/range"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/row" }
        }
      },
      "required": ["label", "rows"],
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/inline" },
        "sub": {
          "description": "行の小分類。続く行が同じ値なら、テンプレートは1つにまとめて見せてよい。",
          "type": "string",
          "minLength": 1
        },
        "segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/segment" }
        },
        "note": {
          "description": "区間の代わりに、その期間に添える説明(例 移行先になり得ない理由)。",
          "$ref": "#/$defs/rowNote"
        }
      },
      "required": ["label"],
      "anyOf": [{ "required": ["segments"] }, { "required": ["note"] }],
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "properties": {
        "from": { "$ref": "#/$defs/date" },
        "to": { "$ref": "#/$defs/date" },
        "status": { "$ref": "#/$defs/status" },
        "label": { "$ref": "#/$defs/inline" },
        "openEnd": {
          "description": "to より先も続く(終わりが決まっていない)。",
          "type": "boolean"
        },
        "tentative": {
          "description": "予定・見込みで、確定していない区間。",
          "type": "boolean"
        }
      },
      "required": ["from", "to", "status"],
      "additionalProperties": false
    },
    "rowNote": {
      "type": "object",
      "properties": {
        "from": { "$ref": "#/$defs/date" },
        "to": { "$ref": "#/$defs/date" },
        "text": { "$ref": "#/$defs/inline" }
      },
      "required": ["from", "to", "text"],
      "additionalProperties": false
    },

    "annotation": {
      "description": "ある日付への吹き出し。どこに置くか(上下・高さ)はサブシステムが重なりを避けて決める。",
      "type": "object",
      "properties": {
        "at": { "$ref": "#/$defs/date" },
        "target": {
          "description": "指したいグループか行の id。省くとチャート全体を指す。",
          "$ref": "#/$defs/id"
        },
        "text": { "$ref": "#/$defs/inline" },
        "status": { "$ref": "#/$defs/status" },
        "emphasis": {
          "description": "とくに目立たせたい注釈。",
          "type": "boolean"
        }
      },
      "required": ["at", "text"],
      "additionalProperties": false
    }
  }
}
