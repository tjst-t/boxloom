{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boxloom.invalid/schema/ir/0.1/core.schema.json",
  "title": "Boxloom IR core (0.1)",
  "description": "意味の中間表現(IR)のコア。意味だけを持ち、色・座標・大きさ・Box の組み方は持たない。サブシステムのデータは $dynamicRef の差し込み口(#subsystem)で受け、中身の検査は boxloom-ir.schema.json が差し込む各サブシステムの Schema に任せる。",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "エディタや AI に Schema を知らせるための URI(検査には使わない)。",
      "type": "string"
    },
    "boxloom": {
      "description": "IR の版。",
      "const": "0.1"
    },
    "template": {
      "description": "使うテンプレートの名前。値の表・規則・骨組み・部品はテンプレートが持つ。",
      "$ref": "#/$defs/name"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "required": [
    "boxloom",
    "slides"
  ],
  "additionalProperties": false,
  "$defs": {
    "name": {
      "description": "テンプレート名・変種名・サブシステム名などの識別子。",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "variant": {
      "description": "テンプレートが用意した名前つきの変種(例 dense)。どの名前があるかはテンプレートが決め、Schema では形だけを検査する。",
      "$ref": "#/$defs/name"
    },
    "id": {
      "description": "参照のための識別子(注釈の対象など)。文書の中で一意にする。",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "date": {
      "description": "年月(YYYY-MM)か年月日(YYYY-MM-DD)。",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?$"
    },
    "dateRange": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/date"
        },
        "to": {
          "$ref": "#/$defs/date"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "lines": {
      "description": "意味のある改行を持つ短いラベル(例 グループ名の各行)。1行なら文字列でよい。",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "inline": {
      "description": "文中の表現。ただの文字列か、文字列とインライン要素の並び。見た目(太字・色・大きさ)ではなく意味(強調・コード・リンク)だけを書く。",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/inlineElement"
              }
            ]
          }
        }
      ]
    },
    "inlineElement": {
      "description": "インライン要素。type で種類を選ぶ。",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "em",
            "code",
            "link",
            "br"
          ]
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "em"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/inlineEm"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "code"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/inlineCode"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "link"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/inlineLink"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "br"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/inlineBreak"
          }
        }
      ]
    },
    "inlineEm": {
      "description": "強調。どう見せるか(太字・色)はテンプレートが決める。",
      "type": "object",
      "properties": {
        "type": {
          "const": "em"
        },
        "content": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "inlineCode": {
      "type": "object",
      "properties": {
        "type": {
          "const": "code"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "inlineLink": {
      "type": "object",
      "properties": {
        "type": {
          "const": "link"
        },
        "href": {
          "type": "string",
          "format": "uri"
        },
        "content": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "href",
        "content"
      ],
      "additionalProperties": false
    },
    "inlineBreak": {
      "description": "意味のある改行(段落の中で行を分けたいとき)。",
      "type": "object",
      "properties": {
        "type": {
          "const": "br"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/inline"
        },
        "subtitle": {
          "$ref": "#/$defs/inline"
        },
        "author": {
          "$ref": "#/$defs/inline"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "confidential": {
          "description": "機密区分の短い文(例「社外秘」)。テンプレートが表紙とフッターに出す。",
          "$ref": "#/$defs/inline"
        },
        "disclaimer": {
          "description": "文書全体の免責・但し書き(1回だけ書く)。テンプレートが表紙に出す。",
          "$ref": "#/$defs/inline"
        },
        "toc": {
          "description": "表紙の直後に目次のスライドを置くか(既定 false)。目次は IR に書かず、組み立てで作る(level 1・2 の区切りと、組み立てたあとの頁番号)。",
          "type": "boolean"
        },
        "coverImage": {
          "description": "表紙の写真(飾り。代わりの文は要らない)。文書からの相対パスで、決まりは画像の src と同じ(PNG / JPEG、絶対パス・URL・.. は誤り)。テンプレートが表紙の全面に敷き、closing が true なら終わりのスライドにも敷く。",
          "$ref": "#/$defs/imageSrc"
        },
        "closing": {
          "description": "最後に終わりのスライドを置くか(既定 false)。文を書けば終わりのスライドを置き、その文をテンプレートが終わりのスライドに置く(例「ご清聴ありがとうございました」・問い合わせ先)。終わりのスライドは IR に書かず、組み立てで作る(coverImage があればその写真を敷く)。",
          "oneOf": [
            {"type": "boolean"},
            {"$ref": "#/$defs/inline"}
          ]
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "slide": {
      "description": "スライド。type で種類を選ぶ。",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "cover",
            "content",
            "section",
            "statement"
          ]
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "cover"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/coverSlide"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "content"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/contentSlide"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "section"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/sectionSlide"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "statement"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/statementSlide"
          }
        }
      ]
    },
    "coverSlide": {
      "description": "表紙。title などを省くと meta の値を使う。",
      "type": "object",
      "properties": {
        "type": {
          "const": "cover"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "title": {
          "$ref": "#/$defs/inline"
        },
        "subtitle": {
          "$ref": "#/$defs/inline"
        },
        "author": {
          "$ref": "#/$defs/inline"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "contentSlide": {
      "type": "object",
      "properties": {
        "type": {
          "const": "content"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "title": {
          "description": "スライドの題。短い見出しで、1行に収める(折り返すと check の警告 title-wrap)。",
          "$ref": "#/$defs/inline"
        },
        "lead": {
          "description": "リード文。題の下に置く、このスライドで言いたいことを述べる文(1〜2行)。本文の流れの外で、テンプレートが題の直下に置く。",
          "$ref": "#/$defs/inline"
        },
        "marker": {
          "description": "スライドの隅の印(いまどのパターン・どの要因の話か。1・2・A・B のような、空白を含まない2字までの短い文)。描くかどうか・形はテンプレートが決める(report は右上の隅の三角と丸の中の印、その左に直前の区切りの題。dark・light は描かない)。",
          "type": "string",
          "minLength": 1,
          "maxLength": 2,
          "pattern": "^\\S{1,2}$"
        },
        "density": {
          "description": "本文の密度。dense は「このページは参照用に詰めて読ませる」(表・一覧の密なページ)という意味で、本文の部品・サブシステムの字の大きさ・間隔をテンプレートの値の表の dense の組にする。題・リード・出典・フッターは変えない。省けば normal。テンプレートが名乗る見た目の名前 variant とは別の欄。",
          "enum": [
            "normal",
            "dense"
          ]
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "source": {
          "description": "このスライドの出典(出どころ・母数・時点)。本文の流れの外で、テンプレートが本文の下・フッターの上に置く。",
          "$ref": "#/$defs/inline"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      },
      "required": [
        "type",
        "title",
        "body"
      ],
      "additionalProperties": false
    },
    "sectionSlide": {
      "description": "章の区切り(docs/patterns.md の R1)。章の題だけを持ち、本文は持たない。",
      "type": "object",
      "properties": {
        "type": {
          "const": "section"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "title": {
          "description": "章の題。",
          "$ref": "#/$defs/inline"
        },
        "level": {
          "description": "区切りの階層(1 章・2 節・3 節の中の項目。既定 1)。親の無い階層(1 より前の 2 など)は boxloom check の誤り(section-level)。",
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      },
      "required": [
        "type",
        "title"
      ],
      "additionalProperties": false
    },
    "statementSlide": {
      "description": "主張(R2)。このスライドで言うことが1文だけのとき。その1文だけを持ち、題も本文も持たない(根拠はほかのスライドにある)。",
      "type": "object",
      "properties": {
        "type": {
          "const": "statement"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "content": {
          "description": "言いたいことの1文。",
          "$ref": "#/$defs/inline"
        },
        "source": {
          "description": "このスライドの出典(出どころ・母数・時点)。本文の流れの外で、テンプレートが本文の下・フッターの上に置く。",
          "$ref": "#/$defs/inline"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "notes": {
      "description": "発表者ノート(スライドには出ない)。文字だけの文字列で、改行が段落の区切り。",
      "type": "string"
    },
    "block": {
      "description": "スライドの本文に並べるブロック。type で種類を選ぶ。subsystem は差し込み口。標準でない型(pairs)は schema/types/ の型ごとの Schema で検査する。",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "paragraph",
            "points",
            "compare",
            "note",
            "takeaway",
            "stat",
            "quote",
            "subsystem",
            "columns",
            "table",
            "image",
            "gallery",
            "pairs"
          ]
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "paragraph"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/paragraph"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "points"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/points"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "compare"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/compare"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "note"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/note"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "takeaway"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/takeaway"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "stat"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/stat"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "quote"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/quote"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "columns"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/columns"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/table"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/image"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "gallery"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/gallery"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "subsystem"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$dynamicRef": "#subsystem"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pairs"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "types/pairs.schema.json"
          }
        }
      ]
    },
    "paragraph": {
      "type": "object",
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "content": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "points": {
      "description": "箇条。入れ子にできる。ordered なら番号つき(番号の形はテンプレート)。",
      "type": "object",
      "properties": {
        "type": {
          "const": "points"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "ordered": {
          "description": "番号つきの箇条(手順・読む順のように、順序に意味がある)。番号の形はテンプレートの値の表 orderedStyle が決める。既定は false。",
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pointItem"
          }
        }
      },
      "required": [
        "type",
        "items"
      ],
      "additionalProperties": false
    },
    "pointItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/inline"
        },
        {
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/inline"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/pointItem"
              }
            },
            "ordered": {
              "description": "入れ子の箇条(items)を番号つきにする(親の箇条とは独立)。入れ子の段の番号は 1. の形。items が要る。既定は false。",
              "type": "boolean"
            }
          },
          "required": [
            "content"
          ],
          "dependentRequired": {
            "ordered": [
              "items"
            ]
          },
          "additionalProperties": false
        }
      ]
    },
    "compare": {
      "description": "選択肢の比較。選択肢ごとに良い点と悪い点を持つ。",
      "type": "object",
      "properties": {
        "type": {
          "const": "compare"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/compareOption"
          }
        }
      },
      "required": [
        "type",
        "options"
      ],
      "additionalProperties": false
    },
    "compareOption": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/inline"
        },
        "pros": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inline"
          }
        },
        "cons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inline"
          }
        }
      },
      "required": [
        "label"
      ],
      "anyOf": [
        {
          "required": [
            "pros"
          ]
        },
        {
          "required": [
            "cons"
          ]
        }
      ],
      "additionalProperties": false
    },
    "note": {
      "description": "補足・注記。",
      "type": "object",
      "properties": {
        "type": {
          "const": "note"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "content": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "takeaway": {
      "description": "結論(R2)。本文の中で言いたいことを1文で目立たせる。",
      "type": "object",
      "properties": {
        "type": {
          "const": "takeaway"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "content": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "stat": {
      "description": "統計強調(R3)。1〜4個の数を、単位と短い説明つきで強く見せる。並べ方と数の字の大きさはテンプレートが決める。",
      "type": "object",
      "properties": {
        "type": {
          "const": "stat"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/statItem"
          }
        }
      },
      "required": [
        "type",
        "items"
      ],
      "additionalProperties": false
    },
    "statItem": {
      "type": "object",
      "properties": {
        "value": {
          "description": "数を書いたとおりの文字で(例 \"12\"・\"−40\"・\"3 → 12\")。計算はしない。数字を1つ以上含む。",
          "type": "string",
          "minLength": 1,
          "pattern": "[0-9０-９]"
        },
        "unit": {
          "description": "単位(例 \"%\"・\"台\")。数の後ろに置く。",
          "type": "string",
          "minLength": 1
        },
        "label": {
          "description": "その数が何かの短い説明。",
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false
    },
    "quote": {
      "description": "引用(R11)。他人の言葉と、その出どころ。出どころは必須。",
      "type": "object",
      "properties": {
        "type": {
          "const": "quote"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "content": {
          "description": "引用した言葉(引用符は書かない。付けるかはテンプレートが決める)。",
          "$ref": "#/$defs/inline"
        },
        "source": {
          "description": "出どころ(誰の・いつの言葉か)。",
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "content",
        "source"
      ],
      "additionalProperties": false
    },
    "subsystem": {
      "$dynamicAnchor": "subsystem",
      "description": "サブシステムの差し込み口の既定。コアだけで検査したときは、名前と data があることだけを見る。data の中身は、boxloom-ir.schema.json が差し込む各サブシステムの Schema が検査する。",
      "type": "object",
      "properties": {
        "type": {
          "const": "subsystem"
        },
        "subsystem": {
          "$ref": "#/$defs/name"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "subsystem",
        "data"
      ],
      "additionalProperties": false
    },
    "columns": {
      "description": "並列のまとまり(2〜3個)。段組みの指定ではなく「並べて読ませる」という意味。幅の比は数で書かず、主のまとまりに role: main を付ける(テンプレートがそれを広く取る)。",
      "type": "object",
      "properties": {
        "type": {
          "const": "columns"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "flow": {
          "description": "左のまとまりが右のまとまりにつながる(前提→結論、発見→対応)という意味。既定は false。つながりの印(矢印など)の形はテンプレートが決める。",
          "type": "boolean"
        },
        "columns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/column"
          },
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "main"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      },
      "required": [
        "type",
        "columns"
      ],
      "additionalProperties": false
    },
    "column": {
      "description": "並列のまとまりの1つ。title はまとまりの題(意味の一部)。role: main はこのまとまりが主で、ほかはそれを補うという意味(1つの columns に1つまで)。",
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/inline"
        },
        "role": {
          "enum": [
            "main"
          ]
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/columnBlock"
          }
        }
      },
      "required": [
        "body"
      ],
      "additionalProperties": false
    },
    "columnBlock": {
      "description": "まとまりの中に置けるブロック。columns・compare は置けない。対の並び(pairs)と画像の並び(gallery)は置ける。サブシステムはまとまりの幅で測れる図だけ:グラフ(chart)・循環の図(cycle)・フェーズの図(phases)・評価の格子(matrix)・組織図(orgchart)(図の横に読み取り・段ごとの説明を置く形)。",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "paragraph",
            "points",
            "note",
            "table",
            "image",
            "gallery",
            "pairs",
            "subsystem"
          ]
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "paragraph"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/paragraph"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "points"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/points"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "note"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/note"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/table"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/image"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "gallery"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/gallery"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pairs"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "types/pairs.schema.json"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "subsystem"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$dynamicRef": "#subsystem",
            "properties": {
              "subsystem": {
                "enum": [
                  "chart",
                  "cycle",
                  "phases",
                  "matrix",
                  "orgchart"
                ]
              }
            }
          }
        }
      ]
    },
    "table": {
      "description": "表。行×列の文字・数。1行目は見出しの行(header)。列の配置・幅は書かない(テンプレートが中身から決める)。本体・合計の行のセルはインラインか、セルの中の箇条({\"points\": [...]}、2項目以上)。 長い表は作者がスライドごとに分け、続きのスライドの表に continues: true を書く(見出しの行は書かない。最初の表の見出しの行・列の数・groups を引き継ぎ、Boxloom が各枚に見出しの行と「n/m」の印を付け、列の幅をそろえる)。",
      "type": "object",
      "properties": {
        "type": {
          "const": "table"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "caption": {
          "$ref": "#/$defs/inline"
        },
        "header": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inline"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/tableCell"
            }
          }
        },
        "groups": {
          "description": "行の群(任意)。先頭の列を群の列とし、群の名前を縦に結合したセルで描く。群は上から順に rows 個ずつの本体の行をまとめる(rows の和は本体の行の数)。groups があると header の先頭が群の列の見出しで、本体の各行のセルは header より1つ少ない(群の列を除く)。total は header と同じ数。",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tableGroup"
          }
        },
        "total": {
          "description": "合計の行(rows の後ろに置く。セルの数は header と同じ)。テンプレートが本体の行と見分けて描く。",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tableCell"
          }
        },
        "continues": {
          "description": "前のスライドの表の続き(true だけを書く)。すぐ前のスライドの本文の最後の表に続く。header を書かない。列の数・groups の有無は最初の表と同じ。total はひと続きの最後の表だけ。",
          "const": true
        }
      },
      "required": [
        "type",
        "rows"
      ],
      "additionalProperties": false,
      "if": {
        "required": [
          "continues"
        ]
      },
      "then": {
        "not": {
          "required": [
            "header"
          ]
        }
      },
      "else": {
        "required": [
          "header"
        ]
      }
    },
    "tableCell": {
      "description": "表の本体・合計の行のセル1つ。インラインか、セルの中の箇条(points。項目はインラインで2つ以上、空の項目は不可。項目が1つならただのインラインで書く)。見出しの行のセルはインラインだけ。",
      "oneOf": [
        {
          "$ref": "#/$defs/inline"
        },
        {
          "type": "object",
          "properties": {
            "points": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "required": [
            "points"
          ],
          "additionalProperties": false
        }
      ]
    },
    "tableGroup": {
      "description": "表の行の群1つ。label は群の名前(空は不可)、rows はこの群の本体の行の数。",
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/inline"
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "label",
        "rows"
      ],
      "additionalProperties": false
    },
    "imageSrc": {
      "description": "画像のファイル。文書のファイルからの相対パスで、区切りは /。絶対パス・URL・文書のフォルダの外(..)は書けない。PNG か JPEG(形式は中身で見る。boxloom check)。",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!(.*/)?\\.\\.(/|$))[^\\\\]+$"
    },
    "imageAlt": {
      "description": "代わりの文(読み上げと、画像が無いときのため)。必須で、空白だけは不可。",
      "type": "string",
      "pattern": "\\S"
    },
    "image": {
      "description": "画像1枚。縦横比を保って枠に収める(切り抜かない・引き伸ばさない)。置き方はテンプレート。",
      "type": "object",
      "properties": {
        "type": {
          "const": "image"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "src": {
          "$ref": "#/$defs/imageSrc"
        },
        "alt": {
          "$ref": "#/$defs/imageAlt"
        },
        "caption": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "src",
        "alt"
      ],
      "additionalProperties": false
    },
    "galleryImage": {
      "type": "object",
      "properties": {
        "src": {
          "$ref": "#/$defs/imageSrc"
        },
        "alt": {
          "$ref": "#/$defs/imageAlt"
        },
        "caption": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "src",
        "alt"
      ],
      "additionalProperties": false
    },
    "gallery": {
      "description": "画像の並び(2〜6枚)。並べ方(1段か2段か)はテンプレートが枚数から決める。",
      "type": "object",
      "properties": {
        "type": {
          "const": "gallery"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "images": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/galleryImage"
          }
        }
      },
      "required": [
        "type",
        "images"
      ],
      "additionalProperties": false
    }
  }
}
