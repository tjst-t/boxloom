{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boxloom.invalid/schema/ir/0.1/core.schema.json",
  "title": "Boxloom IR core (0.1)",
  "description": "意味の中間表現(IR)のコア。意味だけを持ち、色・座標・大きさ・Box の組み方は持たない。サブシステムのデータは $dynamicRef の差し込み口(#subsystem)で受け、中身の検査は boxloom-ir.schema.json が差し込む各サブシステムの Schema に任せる。",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "エディタや AI に Schema を知らせるための URI(検査には使わない)。",
      "type": "string"
    },
    "boxloom": {
      "description": "IR の版。",
      "const": "0.1"
    },
    "template": {
      "description": "使うテンプレートの名前。値の表・規則・骨組み・部品はテンプレートが持つ。",
      "$ref": "#/$defs/name"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "required": [
    "boxloom",
    "slides"
  ],
  "additionalProperties": false,
  "$defs": {
    "name": {
      "description": "テンプレート名・変種名・サブシステム名などの識別子。",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "variant": {
      "description": "テンプレートが用意した名前つきの変種(例 dense)。どの名前があるかはテンプレートが決め、Schema では形だけを検査する。",
      "$ref": "#/$defs/name"
    },
    "id": {
      "description": "参照のための識別子(注釈の対象など)。文書の中で一意にする。",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "date": {
      "description": "年月(YYYY-MM)か年月日(YYYY-MM-DD)。",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?$"
    },
    "dateRange": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/date"
        },
        "to": {
          "$ref": "#/$defs/date"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "lines": {
      "description": "意味のある改行を持つ短いラベル(例 グループ名の各行)。1行なら文字列でよい。",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "inline": {
      "description": "文中の表現。ただの文字列か、文字列とインライン要素の並び。見た目(太字・色・大きさ)ではなく意味(強調・コード・リンク)だけを書く。",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/inlineElement"
              }
            ]
          }
        }
      ]
    },
    "inlineElement": {
      "description": "インライン要素。type で種類を選ぶ。",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "em",
            "code",
            "link",
            "br"
          ]
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "em"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/inlineEm"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "code"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/inlineCode"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "link"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/inlineLink"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "br"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/inlineBreak"
          }
        }
      ]
    },
    "inlineEm": {
      "description": "強調。どう見せるか(太字・色)はテンプレートが決める。",
      "type": "object",
      "properties": {
        "type": {
          "const": "em"
        },
        "content": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "inlineCode": {
      "type": "object",
      "properties": {
        "type": {
          "const": "code"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "inlineLink": {
      "type": "object",
      "properties": {
        "type": {
          "const": "link"
        },
        "href": {
          "type": "string",
          "format": "uri"
        },
        "content": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "href",
        "content"
      ],
      "additionalProperties": false
    },
    "inlineBreak": {
      "description": "意味のある改行(段落の中で行を分けたいとき)。",
      "type": "object",
      "properties": {
        "type": {
          "const": "br"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/inline"
        },
        "subtitle": {
          "$ref": "#/$defs/inline"
        },
        "author": {
          "$ref": "#/$defs/inline"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "confidential": {
          "description": "機密区分の短い文(例「社外秘」)。テンプレートが表紙とフッターに出す。",
          "$ref": "#/$defs/inline"
        },
        "disclaimer": {
          "description": "文書全体の免責・但し書き(1回だけ書く)。テンプレートが表紙に出す。",
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "slide": {
      "description": "スライド。type で種類を選ぶ。",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "cover",
            "content",
            "section",
            "statement"
          ]
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "cover"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/coverSlide"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "content"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/contentSlide"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "section"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/sectionSlide"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "statement"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/statementSlide"
          }
        }
      ]
    },
    "coverSlide": {
      "description": "表紙。title などを省くと meta の値を使う。",
      "type": "object",
      "properties": {
        "type": {
          "const": "cover"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "title": {
          "$ref": "#/$defs/inline"
        },
        "subtitle": {
          "$ref": "#/$defs/inline"
        },
        "author": {
          "$ref": "#/$defs/inline"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "contentSlide": {
      "type": "object",
      "properties": {
        "type": {
          "const": "content"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "title": {
          "$ref": "#/$defs/inline"
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "source": {
          "description": "このスライドの出典(出どころ・母数・時点)。本文の流れの外で、テンプレートが本文の下・フッターの上に置く。",
          "$ref": "#/$defs/inline"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      },
      "required": [
        "type",
        "title",
        "body"
      ],
      "additionalProperties": false
    },
    "sectionSlide": {
      "description": "章の区切り(docs/patterns.md の R1)。章の題だけを持ち、本文は持たない。",
      "type": "object",
      "properties": {
        "type": {
          "const": "section"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "title": {
          "description": "章の題。",
          "$ref": "#/$defs/inline"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      },
      "required": [
        "type",
        "title"
      ],
      "additionalProperties": false
    },
    "statementSlide": {
      "description": "主張(R2)。このスライドで言うことが1文だけのとき。その1文だけを持ち、題も本文も持たない(根拠はほかのスライドにある)。",
      "type": "object",
      "properties": {
        "type": {
          "const": "statement"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "content": {
          "description": "言いたいことの1文。",
          "$ref": "#/$defs/inline"
        },
        "source": {
          "description": "このスライドの出典(出どころ・母数・時点)。本文の流れの外で、テンプレートが本文の下・フッターの上に置く。",
          "$ref": "#/$defs/inline"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "notes": {
      "description": "発表者ノート(スライドには出ない)。文字だけの文字列で、改行が段落の区切り。",
      "type": "string"
    },
    "block": {
      "description": "スライドの本文に並べるブロック。type で種類を選ぶ。subsystem は差し込み口。",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "paragraph",
            "points",
            "compare",
            "note",
            "takeaway",
            "stat",
            "quote",
            "subsystem",
            "columns",
            "table",
            "image",
            "gallery"
          ]
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "paragraph"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/paragraph"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "points"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/points"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "compare"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/compare"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "note"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/note"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "takeaway"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/takeaway"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "stat"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/stat"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "quote"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/quote"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "columns"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/columns"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/table"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/image"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "gallery"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/gallery"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "subsystem"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$dynamicRef": "#subsystem"
          }
        }
      ]
    },
    "paragraph": {
      "type": "object",
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "content": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "points": {
      "description": "箇条。入れ子にできる。",
      "type": "object",
      "properties": {
        "type": {
          "const": "points"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pointItem"
          }
        }
      },
      "required": [
        "type",
        "items"
      ],
      "additionalProperties": false
    },
    "pointItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/inline"
        },
        {
          "type": "object",
          "properties": {
            "content": {
              "$ref": "#/$defs/inline"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/pointItem"
              }
            }
          },
          "required": [
            "content"
          ],
          "additionalProperties": false
        }
      ]
    },
    "compare": {
      "description": "選択肢の比較。選択肢ごとに良い点と悪い点を持つ。",
      "type": "object",
      "properties": {
        "type": {
          "const": "compare"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/compareOption"
          }
        }
      },
      "required": [
        "type",
        "options"
      ],
      "additionalProperties": false
    },
    "compareOption": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/inline"
        },
        "pros": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inline"
          }
        },
        "cons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inline"
          }
        }
      },
      "required": [
        "label"
      ],
      "anyOf": [
        {
          "required": [
            "pros"
          ]
        },
        {
          "required": [
            "cons"
          ]
        }
      ],
      "additionalProperties": false
    },
    "note": {
      "description": "補足・注記。",
      "type": "object",
      "properties": {
        "type": {
          "const": "note"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "content": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "takeaway": {
      "description": "結論(R2)。本文の中で言いたいことを1文で目立たせる。",
      "type": "object",
      "properties": {
        "type": {
          "const": "takeaway"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "content": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    },
    "stat": {
      "description": "統計強調(R3)。1〜4個の数を、単位と短い説明つきで強く見せる。並べ方と数の字の大きさはテンプレートが決める。",
      "type": "object",
      "properties": {
        "type": {
          "const": "stat"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/statItem"
          }
        }
      },
      "required": [
        "type",
        "items"
      ],
      "additionalProperties": false
    },
    "statItem": {
      "type": "object",
      "properties": {
        "value": {
          "description": "数を書いたとおりの文字で(例 \"12\"・\"−40\"・\"3 → 12\")。計算はしない。数字を1つ以上含む。",
          "type": "string",
          "minLength": 1,
          "pattern": "[0-9０-９]"
        },
        "unit": {
          "description": "単位(例 \"%\"・\"台\")。数の後ろに置く。",
          "type": "string",
          "minLength": 1
        },
        "label": {
          "description": "その数が何かの短い説明。",
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false
    },
    "quote": {
      "description": "引用(R11)。他人の言葉と、その出どころ。出どころは必須。",
      "type": "object",
      "properties": {
        "type": {
          "const": "quote"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "content": {
          "description": "引用した言葉(引用符は書かない。付けるかはテンプレートが決める)。",
          "$ref": "#/$defs/inline"
        },
        "source": {
          "description": "出どころ(誰の・いつの言葉か)。",
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "content",
        "source"
      ],
      "additionalProperties": false
    },
    "subsystem": {
      "$dynamicAnchor": "subsystem",
      "description": "サブシステムの差し込み口の既定。コアだけで検査したときは、名前と data があることだけを見る。data の中身は、boxloom-ir.schema.json が差し込む各サブシステムの Schema が検査する。",
      "type": "object",
      "properties": {
        "type": {
          "const": "subsystem"
        },
        "subsystem": {
          "$ref": "#/$defs/name"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "subsystem",
        "data"
      ],
      "additionalProperties": false
    },
    "columns": {
      "description": "並列のまとまり(2〜3個)。段組みの指定ではなく「並べて読ませる」という意味。幅の比は数で書かず、主のまとまりに role: main を付ける(テンプレートがそれを広く取る)。",
      "type": "object",
      "properties": {
        "type": {
          "const": "columns"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "columns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/column"
          },
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "main"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      },
      "required": [
        "type",
        "columns"
      ],
      "additionalProperties": false
    },
    "column": {
      "description": "並列のまとまりの1つ。title はまとまりの題(意味の一部)。role: main はこのまとまりが主で、ほかはそれを補うという意味(1つの columns に1つまで)。",
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/inline"
        },
        "role": {
          "enum": [
            "main"
          ]
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/columnBlock"
          }
        }
      },
      "required": [
        "body"
      ],
      "additionalProperties": false
    },
    "columnBlock": {
      "description": "まとまりの中に置けるブロック。columns・compare・gallery・サブシステムは置けない。",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "paragraph",
            "points",
            "note",
            "table",
            "image"
          ]
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "paragraph"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/paragraph"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "points"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/points"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "note"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/note"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/table"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "$ref": "#/$defs/image"
          }
        }
      ]
    },
    "table": {
      "description": "表。行×列の文字・数。1行目は見出しの行(header)。列の配置・幅は書かない(テンプレートが中身から決める)。セルはインラインだけ。",
      "type": "object",
      "properties": {
        "type": {
          "const": "table"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "caption": {
          "$ref": "#/$defs/inline"
        },
        "header": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inline"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/inline"
            }
          }
        },
        "total": {
          "description": "合計の行(rows の後ろに置く。セルの数は header と同じ)。テンプレートが本体の行と見分けて描く。",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inline"
          }
        }
      },
      "required": [
        "type",
        "header",
        "rows"
      ],
      "additionalProperties": false
    },
    "imageSrc": {
      "description": "画像のファイル。文書のファイルからの相対パスで、区切りは /。絶対パス・URL・文書のフォルダの外(..)は書けない。PNG か JPEG(形式は中身で見る。boxloom check)。",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!(.*/)?\\.\\.(/|$))[^\\\\]+$"
    },
    "imageAlt": {
      "description": "代わりの文(読み上げと、画像が無いときのため)。必須で、空白だけは不可。",
      "type": "string",
      "pattern": "\\S"
    },
    "image": {
      "description": "画像1枚。縦横比を保って枠に収める(切り抜かない・引き伸ばさない)。置き方はテンプレート。",
      "type": "object",
      "properties": {
        "type": {
          "const": "image"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "src": {
          "$ref": "#/$defs/imageSrc"
        },
        "alt": {
          "$ref": "#/$defs/imageAlt"
        },
        "caption": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "src",
        "alt"
      ],
      "additionalProperties": false
    },
    "galleryImage": {
      "type": "object",
      "properties": {
        "src": {
          "$ref": "#/$defs/imageSrc"
        },
        "alt": {
          "$ref": "#/$defs/imageAlt"
        },
        "caption": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "src",
        "alt"
      ],
      "additionalProperties": false
    },
    "gallery": {
      "description": "画像の並び(2〜6枚)。並べ方(1段か2段か)はテンプレートが枚数から決める。",
      "type": "object",
      "properties": {
        "type": {
          "const": "gallery"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "images": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/galleryImage"
          }
        }
      },
      "required": [
        "type",
        "images"
      ],
      "additionalProperties": false
    }
  }
}
