    {
      "type": "content",
      "title": "機能の満足度は検索が最も高く、印刷が最も低い",
      "body": [
        {
          "type": "subsystem",
          "subsystem": "chart",
          "data": {
            "compare": "item",
            "unit": "点",
            "categories": [
              "検索",
              "通知",
              "共有",
              "設定",
              "印刷"
            ],
            "emphasis": [
              "印刷"
            ],
            "series": [
              {
                "name": "満足度(5点満点)",
                "values": [
                  4.5,
                  4.1,
                  3.8,
                  3.2,
                  2.6
                ]
              }
            ]
          }
        },
        {
          "type": "points",
          "items": [
            "印刷は次の四半期に作り直す"
          ]
        }
      ]
    },
    {
